rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidString(field, maxLen) {
      return field is string && field.size() > 0 && field.size() <= maxLen;
    }

    // Blank allowed (e.g. a testimonial's job title and business name).
    function isOptionalString(field, maxLen) {
      return field is string && field.size() <= maxLen;
    }

    // Admin = the `admin` custom claim (scripts/set-admin-claim.mjs). The
    // verified-email allowlist is the transition fallback — remove it once the
    // claim is confirmed (see the security notes (~/Dev/Apps/blueprints/portfolio-security.md, kept out of this public repo)).
    function isPortfolioAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        (request.auth.token.email in ['ruben.jim.co@gmail.com'] && request.auth.token.email_verified == true)
      );
    }

    // Legacy contact intake collection.
    // Keep creates public for website form, but restrict broad mutation.
    match /messages/{messageId} {
      allow create: if
        request.resource.data.keys().hasAll(['name', 'email', 'subject', 'message']) &&
        isValidString(request.resource.data.name, 120) &&
        isValidString(request.resource.data.email, 160) &&
        isValidString(request.resource.data.subject, 200) &&
        isValidString(request.resource.data.message, 5000);
      allow read, update, delete: if isPortfolioAdmin();
    }

    // Professional DM moved to Realtime Database (dm/*). Deny all Firestore access under these paths.
    match /conversations/{document=**} {
      allow read, write: if false;
    }

    match /magicLinks/{tokenId} {
      allow read, write: if false;
    }

    // Blog posts collection
    match /blogPosts/{postId} {
      allow read: if true;
      allow create, update, delete: if isPortfolioAdmin();
    }

    function isValidEmailField(field, maxLen) {
      return field is string && field.size() > 0 && field.size() <= maxLen;
    }

    function isAvatarFile(field) {
      return field is string &&
        (field == 'avatar-1.png' || field == 'avatar-2.png' || field == 'avatar-3.png' ||
         field == 'avatar-4.png' || field == 'avatar-5.png' || field == 'avatar-6.png');
    }

    function isValidCustomAvatarDataUrl(field) {
      return field is string &&
        field.size() > 500 &&
        field.size() < 110000 &&
        field.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$');
    }

    // A review Ruben adds by hand (Admin → Reviews): a client's emailed words, or
    // a Google review copied from his listing. Google ones always have stars and
    // may keep a https link to the review. `hidden` = switched off the site.
    function validAdminReview(d) {
      return d.keys().hasAll(['name', 'text', 'avatar', 'source']) &&
        d.keys().hasOnly(['name', 'title', 'company', 'product', 'text', 'rating', 'avatar', 'source', 'reviewUrl', 'hidden', 'createdAt']) &&
        d.source in ['email', 'google'] &&
        isValidString(d.name, 120) &&
        isValidString(d.text, 5000) &&
        (!d.keys().hasAny(['title']) || isOptionalString(d.title, 120)) &&
        (!d.keys().hasAny(['company']) || isOptionalString(d.company, 160)) &&
        (!d.keys().hasAny(['product']) || isOptionalString(d.product, 200)) &&
        (!d.keys().hasAny(['rating']) || (d.rating is int && d.rating >= 1 && d.rating <= 5)) &&
        (d.source != 'google' || d.keys().hasAny(['rating'])) &&
        (!d.keys().hasAny(['reviewUrl']) || (d.source == 'google' && d.reviewUrl is string && d.reviewUrl.size() <= 500 && d.reviewUrl.matches('^https://.+'))) &&
        (!d.keys().hasAny(['hidden']) || d.hidden is bool) &&
        (!d.keys().hasAny(['createdAt']) || d.createdAt is timestamp) &&
        d.avatar is string && d.avatar.size() > 0 && d.avatar.size() <= 500;
    }

    function validTestimonialAvatarPair() {
      return (request.resource.data.avatar == 'custom' &&
          request.resource.data.keys().hasAll(['avatarImageDataUrl']) &&
          isValidCustomAvatarDataUrl(request.resource.data.avatarImageDataUrl)) ||
        (isAvatarFile(request.resource.data.avatar) &&
          !(request.resource.data.keys().hasAll(['avatarImageDataUrl'])));
    }

    // One-time testimonial invite links (admin creates; customer reads + marks used on submit).
    match /testimonialTokens/{tokenId} {
      // Open one invite by its id (the link); listing them all is admin-only —
      // otherwise anyone could read every invitee's name and email.
      allow get: if true;
      allow list: if isPortfolioAdmin();
      allow create: if
        isPortfolioAdmin() &&
        tokenId is string &&
        // 8-char /review/ codes and the original 36-char ones.
        tokenId.matches('^[A-Za-z0-9-]{8,48}$') &&
        request.resource.data.keys().hasAll(['name', 'email', 'product', 'used']) &&
        isValidString(request.resource.data.name, 120) &&
        // Email is optional: the link may be texted instead of emailed.
        (request.resource.data.email == '' || isValidEmailField(request.resource.data.email, 160)) &&
        isValidString(request.resource.data.product, 200) &&
        request.resource.data.used == false;
      allow update: if
        resource.data.used == false &&
        request.resource.data.used == true &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.product == resource.data.product &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isPortfolioAdmin();
    }

    // Customer-submitted testimonials (create only when matching token exists and is unused).
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if (
        request.resource.data.keys().hasAll(
          ['name', 'title', 'company', 'product', 'text', 'rating', 'avatar', 'token']
        ) &&
        // Only Ruben labels a review as emailed/Google or switches it off the site.
        !request.resource.data.keys().hasAny(['source', 'hidden', 'reviewUrl']) &&
        isValidString(request.resource.data.name, 120) &&
        isOptionalString(request.resource.data.title, 120) &&
        isOptionalString(request.resource.data.company, 160) &&
        isValidString(request.resource.data.product, 200) &&
        isValidString(request.resource.data.text, 5000) &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        validTestimonialAvatarPair() &&
        // 8-char /review/ codes and the original 36-char ones (same as testimonialTokens).
        request.resource.data.token is string &&
        request.resource.data.token.matches('^[A-Za-z0-9-]{8,48}$') &&
        exists(/databases/$(database)/documents/testimonialTokens/$(request.resource.data.token)) &&
        get(/databases/$(database)/documents/testimonialTokens/$(request.resource.data.token)).data.used == false
      ) || (isPortfolioAdmin() && validAdminReview(request.resource.data));
      // Admin-only: the avatar (profile image) or text (public quote) alone, the
      // On site switch alone, or a full edit of a review Ruben added himself.
      allow update: if isPortfolioAdmin() && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatar']) &&
          request.resource.data.avatar is string &&
          request.resource.data.avatar.size() > 0 &&
          request.resource.data.avatar.size() <= 500
        ) || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text']) &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 5000
        ) || (
          // The "On site" switch, on any review.
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden']) &&
          request.resource.data.hidden is bool
        ) || (
          // Full edit of a review Ruben added; its source can't change.
          resource.data.get('source', '') in ['email', 'google'] &&
          request.resource.data.source == resource.data.source &&
          validAdminReview(request.resource.data)
        )
      );
      allow delete: if isPortfolioAdmin();
    }
  }
}
