rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isPortfolioAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ruben.jim.co@gmail.com';
    }

    match /instagramPosts/{projectId}/{fileName} {
      allow read: if true;
      allow write: if isPortfolioAdmin()
        && request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Post builder: uploads + thumbnails. Admin only; the editor reads them through
    // download URLs (token-based), so reads don't need to be public.
    match /postDesigns/{designId}/{folder}/{fileName} {
      allow read: if isPortfolioAdmin();
      allow write: if isPortfolioAdmin()
        && (folder == 'assets' || folder == 'exports')
        && request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isPortfolioAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
